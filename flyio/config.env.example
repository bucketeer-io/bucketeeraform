# Shared configuration for Bucketeer Fly.io deployment.
# Copy this file to config.env and adjust values before deploying:
#   cp flyio/config.env.example flyio/config.env

APP_PREFIX=bucketeer
REGION=sin

# Bucketeer release version (used for all images: app services, migration, etc.)
BUCKETEER_VERSION=v2.2.0-53-g1173b25

# MySQL credentials (used by deploy.sh to set Fly.io secrets)
MYSQL_PASSWORD=bucketeer
MYSQL_ROOT_PASSWORD=bucketeer

# Redis — auto-provisioned via Upstash (fly redis create).
# Credentials are extracted automatically by deploy.sh; nothing to set here.

# Path to certs dir (relative to repo root)
CERTS_DIR=./certs

# Regions for the global API (comma-separated Fly.io region codes).
# The first region should match REGION above. SDKs connect to the nearest one.
# See https://fly.io/docs/reference/regions/ for available regions.
API_REGIONS=sin

# OAuth issuer URL (use your real domain in production)
OAUTH_ISSUER=https://localhost
